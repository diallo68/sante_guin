# MongoDB Atlas - Guinée Santé
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/guinee_sante?retryWrites=true&w=majority

# JWT Secret (changer en production - min 32 caractères, requis, aucune valeur par défaut)
JWT_SECRET=

# URL de l'application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Brevo (email transactionnel — https://app.brevo.com/settings/keys/api)
# Domaine d'expédition à authentifier sur https://app.brevo.com/senders/domain/list
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@mondocteur.org

# Google OAuth (optionnel — laisser vide pour désactiver le bouton Google)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Groq AI (gratuit — console.groq.com)
GROQ_API_KEY=
